# Extra Alpine packages (armv7, latest-stable) installed into the rootfs.
# Dependencies are resolved by tools/apk_resolve.py; !name excludes a package.
devmem2
i2c-tools
tinyalsa
alsa-lib
alsa-utils
kmscube
# ssh over USB networking: dropbear, sftp-server for scp/sftp, rsync,
# udhcpd (busybox-extras) to give the host its address
dropbear
openssh-sftp-server
rsync
busybox-extras
# Mesa: our own build (build.sh mesa: lima, EGL/GBM/GLES 2, no LLVM) in place
# of Alpine's, whose one libgallium has every driver and links libLLVM
!mesa
!mesa-dri-gallium
!mesa-egl
!mesa-gbm
!mesa-gles
!llvm22-libs
!spirv-tools
# RetroArch itself is built by build.sh retroarch (patched for screen
# rotation); these are its runtime libraries, udevd for joypad detection,
# core info files and cores.
eudev
eudev-libs
alsa-lib
libstdc++
libretro-core-info
# RetroArch menu assets (Ozone/XMB/GLUI themes, fonts, sounds) in
# /usr/share/libretro/assets; the launcher uses its Ozone fonts
retroarch-assets
# Launcher (build.sh launcher)
sdl2
sdl2_ttf
libretro-fceumm
libretro-gambatte
libretro-gpsp
libretro-mgba
# EmulationStation (build.sh emulationstation): runtime libraries. vlc-libs
# only (libvlc, for linking): without VLC's plugins video previews don't play
freeimage
libcurl
pugixml
vlc-libs

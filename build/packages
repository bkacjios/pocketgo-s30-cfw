# Extra Alpine packages (armv7, latest-stable) installed into the rootfs by
# apk itself (apk.static on the build host, build.sh initramfs), so the
# device's package database knows them and "apk upgrade" (the System update
# app) keeps them current. Our own Mesa (build.sh mesa: lima, no LLVM) is
# installed first as the package s30-mesa, which provides Alpine's mesa-*
# names and the EGL/GBM/GLES libraries, so nothing pulls Alpine's Mesa.
devmem2
i2c-tools
tinyalsa
alsa-lib
alsa-utils
kmscube
# ssh over USB networking: dropbear, sftp-server for scp/sftp, rsync,
# udhcpd (busybox-extras) to give the host its address
dropbear
openssh-sftp-server
rsync
busybox-extras
# RetroArch itself is built by build.sh retroarch (patched for screen
# rotation); these are its runtime libraries, udevd for joypad detection,
# core info files and cores.
eudev
eudev-libs
alsa-lib
libstdc++
libretro-core-info
# RetroArch menu assets (Ozone/XMB/GLUI themes, fonts, sounds) in
# /usr/share/libretro/assets; the launcher uses its Ozone fonts
retroarch-assets
# fsck.fat / fsck.exfat for the loader's card check, e2fsck for the ext4
# root image (see s30-loader); resize2fs to grow the image
dosfstools
exfatprogs
e2fsprogs
# Launcher (build.sh launcher)
sdl2
sdl2_ttf
libretro-fceumm
libretro-gambatte
libretro-gpsp
libretro-mgba
# EmulationStation (build.sh emulationstation): runtime libraries. vlc-libs
# only (libvlc, for linking): without VLC's plugins video previews don't play
freeimage
libcurl
pugixml
vlc-libs

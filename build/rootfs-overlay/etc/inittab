# BusyBox init. /etc/s30/rc sets the system up; the frontend (launcher) and
# shells on the serial console and the USB serial gadget are respawned.

::sysinit:/etc/s30/rc

# s30-display first: the frontend's apps get the display from it (DRM lease)
::respawn:/usr/bin/s30-display /mnt/sd/home/.config/s30/brightness
::respawn:/usr/libexec/s30/frontend
::respawn:/usr/bin/s30-volumed /mnt/sd/home/.config/s30/volume
ttyS0::respawn:-/bin/sh
ttyGS0::respawn:-/bin/sh

::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync
# The card unmounted (busy: read-only), so its FAT is marked clean; else
# s30-loader checks it at every boot (see there)
::shutdown:/bin/umount -a -r

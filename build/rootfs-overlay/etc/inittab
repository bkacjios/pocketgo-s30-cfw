# BusyBox init. /etc/s30/rc sets the system up; the frontend (launcher) and
# shells on the serial console and the USB serial gadget are respawned.

::sysinit:/etc/s30/rc

# s30-display first: the frontend's apps get the display from it (DRM lease)
::respawn:/usr/bin/s30-display /mnt/sd/home/.config/s30/brightness
::respawn:/usr/libexec/s30/frontend
::respawn:/usr/bin/s30-volumed /mnt/sd/home/.config/s30/volume
ttyS0::respawn:-/bin/sh
ttyGS0::respawn:-/bin/sh

::ctrlaltdel:/sbin/reboot
# The root (rootfs.ext4, a loop device over a file on the card) read-only
# first, so nothing writes to the card after the sync. The card itself stays
# busy (the loop device holds its file open for writing), so it can neither
# be unmounted nor made read-only; a plain remount is allowed and clears its
# dirty flag (exfat_reconfigure), which otherwise makes s30-loader check the
# card at every boot (see there). umount's complaints about the busy card
# would show on the LCD (the console is tty1 too).
::shutdown:/bin/mount -o remount,ro /
::shutdown:/bin/sync
::shutdown:/bin/mount -o remount /mnt/sd
::shutdown:/bin/umount -a -r >/dev/null 2>&1

#!/bin/sh
# USB video: the screen as a USB webcam (UVC), streamed by s30-uvc.
#   usb-video on|off   switch it and save the choice (System > USB video)
#   usb-video          apply the saved choice (boot, from /etc/s30/rc)
# The UVC function joins the gadget /etc/s30/rc builds (ACM + NCM), so
# switching rebinds the gadget: the serial and network links drop for a
# moment. Endpoints: ACM and NCM take ep1-4 IN; the UVC stream takes ep5 IN,
# the only one with a 1024-byte FIFO (kernel patch 0002), and the function's
# status endpoint is off, as no IN endpoint is left for it.
. /etc/profile.d/s30.sh
G=/sys/kernel/config/usb_gadget/s30
F=$G/functions/uvc.usb0
SAVED=$HOME/.config/usb_video

# The function's descriptors: one format, YUYV 480x320 at 30 or 15 fps
create() {
	[ -d $F ] && return
	mkdir $F || return 1
	echo 0 > $F/control/enable_interrupt_ep
	echo 0 0 0 > $F/control/terminal/camera/default/bmControls
	echo 0 0 > $F/control/processing/default/bmControls
	mkdir $F/control/header/h
	ln -s $F/control/header/h $F/control/class/fs/h
	ln -s $F/control/header/h $F/control/class/ss/h
	U=$F/streaming/uncompressed/yuyv
	mkdir -p $U/320p
	echo 480 > $U/320p/wWidth
	echo 320 > $U/320p/wHeight
	echo 307200 > $U/320p/dwMaxVideoFrameBufferSize
	echo 36864000 > $U/320p/dwMinBitRate	# 15 fps
	echo 73728000 > $U/320p/dwMaxBitRate	# 30 fps
	printf '333333\n666666\n' > $U/320p/dwFrameInterval
	echo 333333 > $U/320p/dwDefaultFrameInterval
	mkdir $F/streaming/header/h
	ln -s $U $F/streaming/header/h/yuyv
	ln -s $F/streaming/header/h $F/streaming/class/fs/h
	ln -s $F/streaming/header/h $F/streaming/class/hs/h
	ln -s $F/streaming/header/h $F/streaming/class/ss/h
	echo 1024 > $F/streaming_maxpacket
	echo 1 > $F/streaming_interval
	echo "PocketGo S30 screen" > $F/function_name
}

on() {
	[ -e $G/configs/c.1/uvc.usb0 ] && return
	create || return 1
	echo > $G/UDC
	ln -s $F $G/configs/c.1/
	ls /sys/class/udc > $G/UDC || { off; return 1; }
	# The function keeps the gadget off the bus until s30-uvc is up
	s30-uvc </dev/null >>/tmp/s30-uvc.log 2>&1 &
}

off() {
	killall s30-uvc 2>/dev/null
	[ -e $G/configs/c.1/uvc.usb0 ] || return 0
	echo > $G/UDC
	rm $G/configs/c.1/uvc.usb0
	ls /sys/class/udc > $G/UDC
}

case "$1" in
	on|off)
		mkdir -p "${SAVED%/*}"
		"$1" && echo "$1" > "$SAVED"
		;;
	"")
		[ "$(cat "$SAVED" 2>/dev/null)" = on ] && on
		;;
	*)
		echo "usage: usb-video [on|off]" >&2
		exit 2
		;;
esac

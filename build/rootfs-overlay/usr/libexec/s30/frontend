#!/bin/sh
# Frontend, respawned by init: the launcher starts apps from /mnt/sd/apps;
# without it, run RetroArch directly.
. /etc/profile.d/s30.sh
cd "$HOME"
# Apps' output: a log in RAM rather than the serial console (/dev/console),
# where a chatty app would stall on the UART
exec >>/tmp/frontend.log 2>&1
# The display through s30-display (DRM lease), so its OSD can show over apps
[ -f /usr/lib/s30/libs30lease.so ] && export LD_PRELOAD=/usr/lib/s30/libs30lease.so
if [ -x /usr/bin/s30-launcher ]; then
	s30-launcher /mnt/sd/apps
else
	# The boot splash to black (the launcher does this once its window is
	# up); dd stops at the end of the framebuffer (No space left on device)
	dd if=/dev/zero of=/dev/fb0 bs=64k 2>/dev/null
	retroarch -c "$HOME/.config/retroarch/retroarch.cfg"
fi
# init respawns at once: don't spin if it keeps failing
sleep 1

+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Allwinner A31/A33 MIPI DSI host
+ */
+
+#ifndef _SUNXI_DSI_H
+#define _SUNXI_DSI_H
+
+#include <linux/types.h>
+
+struct display_timing;
+
+/*
+ * Enable the DSI block and D-PHY and leave the lanes in LP-11, ready for
+ * sun6i_dsi_dcs_write(). Expects PLL3 to run at 297 MHz.
+ */
+void sun6i_dsi_init(const struct display_timing *mode, int lanes);
+/* Send a DCS command (data[0]) with parameters in low power mode */
+int sun6i_dsi_dcs_write(const u8 *data, size_t len);
+/* Switch to high speed mode and start streaming video from tcon0 */
+void sun6i_dsi_start_video(void);
+/*
+ * Put the DSI block and D-PHY back in reset. The Linux driver only releases
+ * the (shared) reset, and fails its first LP write on a block left streaming.
+ */
+void sun6i_dsi_disable(void);
+
+#endif /* _SUNXI_DSI_H */

diff --git a/drivers/video/ilitek_ili9488_dsi_lcd.c b/drivers/video/ilitek_ili9488_dsi_lcd.c
new file mode 100644
index 00000000..ca3c05d2
--- /dev/null
+++ b/drivers/video/ilitek_ili9488_dsi_lcd.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ilitek ILI9488 MIPI-DSI LCD panel driver, as used in the PocketGo S30.
+ *
+ * The init sequence is the one of the stock firmware (zkswe Linux 3.4
+ * LCD_panel_init), the same as the Linux panel-ilitek-ili9488-dsi driver.
+ */
+
+#include <stdio.h>
+#include <asm/arch/dsi.h>
+#include <asm/gpio.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include "ilitek_ili9488_dsi_lcd.h"
+
+struct ili9488_cmd {
+	u8 len;
+	u8 data[16];
+	u16 delay_ms;
+};
+
+static const struct ili9488_cmd ili9488_init_seq[] = {
+	/* Positive / negative gamma control */
+	{ 16, { 0xe0, 0x00, 0x10, 0x14, 0x01, 0x0e, 0x04, 0x33, 0x56,
+		0x48, 0x03, 0x0c, 0x0b, 0x2b, 0x34, 0x0f } },
+	{ 16, { 0xe1, 0x00, 0x12, 0x18, 0x05, 0x12, 0x06, 0x40, 0x34,
+		0x57, 0x06, 0x10, 0x0c, 0x3b, 0x3f, 0x0f } },
+	/* Power control 1/2, VCOM control */
+	{ 3, { 0xc0, 0x0f, 0x0c } },
+	{ 2, { 0xc1, 0x41 } },
+	{ 4, { 0xc5, 0x00, 0x26, 0x80 } },
+	/* MADCTL: column address order mirrored, BGR */
+	{ 2, { 0x36, 0x48 } },
+	/* COLMOD: 18 bpp */
+	{ 2, { 0x3a, 0x66 } },
+	/* Interface mode, frame rate, inversion, display function control */
+	{ 2, { 0xb0, 0x00 } },
+	{ 2, { 0xb1, 0xa0 } },
+	{ 2, { 0xb4, 0x02 } },
+	{ 3, { 0xb6, 0x02, 0x02 } },
+	/* Set image function: 24-bit data bus off */
+	{ 2, { 0xe9, 0x00 } },
+	/* Display inversion on */
+	{ 1, { 0x21 } },
+	/* Adjust control 3 */
+	{ 5, { 0xf7, 0xa9, 0x51, 0x2c, 0x82 } },
+	/* Sleep out, display on */
+	{ 1, { 0x11 }, 120 },
+	{ 1, { 0x29 }, 20 },
+};
+
+void ili9488_dsi_init(int reset_pin)
+{
+	const struct ili9488_cmd *cmd;
+	int i;
+
+	/* Stock firmware: release, 50 ms, assert, 20 ms, release, 100 ms */
+	if (reset_pin >= 0) {
+		gpio_direction_output(reset_pin, 1);
+		mdelay(50);
+		gpio_direction_output(reset_pin, 0);
+		mdelay(20);
+		gpio_direction_output(reset_pin, 1);
+		mdelay(100);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(ili9488_init_seq); i++) {
+		cmd = &ili9488_init_seq[i];
+		if (sun6i_dsi_dcs_write(cmd->data, cmd->len)) {
+			printf("ili9488: DCS command 0x%02x failed\n",
+			       cmd->data[0]);
+			return;
+		}
+		mdelay(cmd->delay_ms);
+	}
+}

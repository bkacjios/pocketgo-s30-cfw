# Applied on top of sunxi_defconfig.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_ILITEK_ILI9488_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
# /dev/fb0 for the boot splash (s30-splash)
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_SUNXI_RSB=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_IIO=y
CONFIG_AXP20X_ADC=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# USB gadget built by /etc/s30/rc through configfs: serial shell (host
# /dev/ttyACM*) plus NCM networking (ssh); mass storage for the SD card in
# USB disk mode (s30-loader, hold SELECT at power on)
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# USB webcam and sound card functions: the screen and the speaker's
# sound over USB (usb-gadget, s30-uvc, s30-uac)
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_UAC2=y
# Analog stick + gamepad buttons as one input device
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_POCKETGO_S30=y
# Sound card (simple-audio-card) and speaker amp enable GPIO (PH9)
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
# Root filesystem: squashfs image on the SD card, tmpfs overlay (initramfs loader)
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
# Boot logo: linux/logo/logo_linux_clut224.ppm (PocketGo splash, centered)
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
CONFIG_LOGO_LINUX_CLUT224_FILE="drivers/video/logo/logo_pocketgo_s30_clut224.ppm"
# SD card: exFAT
CONFIG_EXFAT_FS=y
# reboot fel: the RTC general-purpose register boot0 checks (s30-fel)
CONFIG_POWER_RESET=y
CONFIG_REBOOT_MODE=y
CONFIG_NVMEM_REBOOT_MODE=y
# Sleep (system menu): s2idle, woken by the AXP power key
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# A33 thermal sensor (allwinner,sun8i-a33-ths): SoC temperature, cpu-thermal zone
CONFIG_SUN4I_GPADC=y

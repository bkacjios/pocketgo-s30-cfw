#!/bin/busybox sh
# initramfs /init: mount the SD card, loop-mount /boot/rootfs.sqfs (read-only
# system) under a tmpfs overlay (writable, lost at reboot) and switch to it.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

fail() { echo "s30-loader: $*" > /dev/console; exec sh; }

mkdir -p /sd /ro /rw /root
i=0
until [ -b /dev/mmcblk0p1 ]; do
	i=$((i + 1)); [ $i -gt 100 ] && fail "no SD card"
	sleep 0.1
done

# USB disk mode: hold SELECT (BTN_SELECT 314) at power on, or the system
# menu's "USB storage" (s30-display leaves /boot/usb-mode on the card and
# reboots; the marker is removed here, so it is one-shot). The whole SD card
# is a USB mass storage device on the PC; nothing on it is mounted here.
# Ejecting it on the PC or pressing START (BTN_START 315) reboots.
usb_mode=0
if s30-keyheld 314; then
	usb_mode=1
elif mount -o ro /dev/mmcblk0p1 /sd 2>/dev/null; then
	if [ -e /sd/boot/usb-mode ]; then
		mount -o remount,rw /sd && rm -f /sd/boot/usb-mode && usb_mode=1
	fi
	umount /sd
fi
if [ $usb_mode = 1 ]; then
	s30-splash -i /usb.bmp
	G=/sys/kernel/config/usb_gadget/s30
	F=$G/functions/mass_storage.usb0
	mount -t configfs configfs /sys/kernel/config
	mkdir -p $G/strings/0x409 $G/configs/c.1 $F
	echo 0x1d6b > $G/idVendor	# Linux Foundation
	echo 0x0104 > $G/idProduct	# Multifunction Composite Gadget
	echo PocketGo > $G/strings/0x409/manufacturer
	echo "PocketGo S30" > $G/strings/0x409/product
	echo s30 > $G/strings/0x409/serialnumber
	# removable: a PC eject closes the backing file (lun.0/file reads empty)
	echo 1 > $F/lun.0/removable
	echo /dev/mmcblk0 > $F/lun.0/file
	ln -s $F $G/configs/c.1/
	i=0
	until [ -n "$(ls /sys/class/udc)" ] || [ $i -gt 50 ]; do
		i=$((i + 1)); sleep 0.1
	done
	ls /sys/class/udc > $G/UDC
	while [ -n "$(cat $F/lun.0/file)" ] && ! s30-keyheld 315; do
		sleep 0.2
	done
	echo > $G/UDC
	sync
	reboot -f
fi

# A card that was not unmounted cleanly (a crash, the battery pulled, a copy
# cut short) is repaired before use. FAT32 has two dirty flags: Linux's,
# bit 0 of boot sector byte 65 (set at mount, cleared at unmount; left alone
# once found set, for fsck), and fsck.fat's, FAT[1] bit 27 clear. fsck.fat
# clears only its own, so Linux's is cleared here after it ran (in the
# backup boot sector too). exFAT: VolumeFlags bit 1 (boot sector offset
# 106) is VolumeDirty; fsck.exfat clears it.
card_byte() { # OFFSET: one byte of the partition, decimal
	dd if=/dev/mmcblk0p1 bs=1 skip=$1 count=1 2>/dev/null | od -An -tu1 | tr -d ' '
}
card_fsck() {
	local rsvd b s dirty
	if [ "$(dd if=/dev/mmcblk0p1 bs=1 skip=82 count=5 2>/dev/null | tr -d "\0")" = FAT32 ]; then
		rsvd=$(dd if=/dev/mmcblk0p1 bs=1 skip=14 count=2 2>/dev/null | od -An -tu2 | tr -d ' ')
		s=$(card_byte 65)
		b=$(card_byte $((rsvd * 512 + 7)))
		dirty=0
		[ -n "$s" ] && [ $((s & 1)) != 0 ] && dirty=1
		[ -n "$b" ] && [ $((b & 8)) = 0 ] && dirty=1
		[ $dirty = 1 ] && echo fsck.fat -a -w
	elif [ "$(dd if=/dev/mmcblk0p1 bs=1 skip=3 count=5 2>/dev/null | tr -d "\0")" = EXFAT ]; then
		b=$(card_byte 106)
		[ -n "$b" ] && [ $((b & 2)) != 0 ] && echo fsck.exfat -y
	fi
}
fsck=$(card_fsck)
if [ -n "$fsck" ]; then
	echo "s30-loader: SD card was not unmounted cleanly, checking it" > /dev/console
	$fsck /dev/mmcblk0p1 > /dev/console 2>&1
	rc=$?
	if [ "${fsck%% *}" = fsck.fat ] && [ $rc -le 1 ]; then # 1: errors corrected
		s=$(card_byte 65)
		bk=$(dd if=/dev/mmcblk0p1 bs=1 skip=50 count=2 2>/dev/null | od -An -tu2 | tr -d ' ')
		for sec in 0 $bk; do # the boot sector and its backup (BkBootSec)
			printf "\\$(printf %03o $((s & ~1)))" |
				dd of=/dev/mmcblk0p1 bs=1 seek=$((sec * 512 + 65)) conv=notrunc 2>/dev/null
		done
	fi
fi

# FAT (stock card) or ext4
mount /dev/mmcblk0p1 /sd || fail "cannot mount SD card"
# Staged update (copied over ssh while the old one is in use as /): installed
# only if it mounts, so a copy cut short by a reboot is dropped, not booted
if [ -f /sd/boot/rootfs.sqfs.new ]; then
	if mount -t squashfs -o loop,ro /sd/boot/rootfs.sqfs.new /ro; then
		umount /ro
		mv /sd/boot/rootfs.sqfs.new /sd/boot/rootfs.sqfs
	else
		echo "s30-loader: rootfs.sqfs.new does not mount, dropped" > /dev/console
		rm -f /sd/boot/rootfs.sqfs.new
	fi
fi
mount -t squashfs -o loop,ro /sd/boot/rootfs.sqfs /ro || fail "cannot mount /boot/rootfs.sqfs"
mount -t tmpfs -o mode=755 tmpfs /rw
mkdir -p /rw/upper /rw/work
mount -t overlay overlay -o lowerdir=/ro,upperdir=/rw/upper,workdir=/rw/work /root ||
	fail "cannot mount overlay"

mkdir -p /root/mnt/sd
mount --move /sd /root/mnt/sd
mount --move /dev /root/dev
umount /proc /sys
exec switch_root /root /sbin/init

+						ARRAY_SIZE(sun8i_codec_hpcom_always_on_widgets));
+	else if (!ret)
+		ret = snd_soc_dapm_new_controls(dapm, sun8i_codec_hpcom_widgets,
+						ARRAY_SIZE(sun8i_codec_hpcom_widgets));
 	if (ret) {
 		dev_err(dev, "Failed to add Headphone DAPM widgets: %d\n", ret);
 		return ret;
@@ -786,9 +903,163 @@ static int sun8i_codec_analog_cmpnt_probe(struct snd_soc_component *cmpnt)
 			return ret;
 	}
 
+	if (quirks->has_headphone && sun8i_headphone_amp_always_on(cmpnt)) {
+		sun8i_codec_hp_on(cmpnt);
+		ret = snd_soc_add_component_controls(cmpnt,
+						     sun8i_codec_hp_amp_switch,

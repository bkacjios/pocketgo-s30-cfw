 	return 0;
 }
 
+/*
+ * Headphone jack (hp-det-gpios) owned by the codec, so that it can switch the
+ * outputs: on boards with a mono speaker amplifier bridged across HPL/HPR
+ * ("allwinner,bridged-mono-speaker"), the speaker plays the DAC's mono mix
+ * differentially while no headphone is in, and is switched off otherwise.
+ * "allwinner,headphone-lr-swapped" swaps the channels for the headphone.
+ */
+struct sun8i_codec_analog_jack {
+	struct snd_soc_component *component;
+	struct snd_soc_jack *jack;
+	struct snd_soc_jack_gpio gpio;
+	struct notifier_block nb;
+	struct delayed_work work;
+	int tries;
+	bool headphone;
+};
+
+/* Sets a card control (both channels where it has two); -ENOENT if missing */
+static int sun8i_codec_jack_set_ctl(struct snd_soc_card *card, const char *name,
+				    int left, int right)
+{
+	struct snd_kcontrol *kctl = snd_soc_card_get_kcontrol(card, name);
+	struct snd_ctl_elem_info info = {};
+	struct snd_ctl_elem_value *val;
+	int ret;
+
+	if (!kctl)
+		return -ENOENT;
+	ret = kctl->info(kctl, &info);
+	if (ret)
+		return ret;
+	val = kzalloc(sizeof(*val), GFP_KERNEL);
+	if (!val)
+		return -ENOMEM;
+	if (info.type == SNDRV_CTL_ELEM_TYPE_ENUMERATED) {
+		val->value.enumerated.item[0] = left;
+		val->value.enumerated.item[1] = right;
+	} else {
+		val->value.integer.value[0] = left;
+		val->value.integer.value[1] = right;
+	}
+	ret = kctl->put(kctl, val);
+	if (ret > 0)
+		snd_ctl_notify(card->snd_card, SNDRV_CTL_EVENT_MASK_VALUE, &kctl->id);
+	kfree(val);
+	return ret < 0 ? ret : 0;
+}
+
+static void sun8i_codec_jack_work(struct work_struct *work)
+{
+	struct sun8i_codec_analog_jack *aj =
+		container_of(work, struct sun8i_codec_analog_jack, work.work);
+	struct snd_soc_component *component = aj->component;
+	struct snd_soc_card *card = aj->jack->card;
+	struct snd_soc_dapm_context *dapm = snd_soc_card_to_dapm(card);
+	bool swap = device_property_read_bool(component->dev,
+					      "allwinner,headphone-lr-swapped");
+	bool hp = aj->headphone;
+	int ret;
+
+	if (!device_property_read_bool(component->dev,
+				       "allwinner,bridged-mono-speaker"))
+		return;
+
+	/* Enum: Stereo, Reverse Stereo, Sum Mono, Mix Mono */
+	ret = sun8i_codec_jack_set_ctl(card, "AIF1 DA0 Stereo Playback Route",
+				       hp ? swap : 3, hp ? swap : 3);
+	if (!ret)
+		ret = sun8i_codec_jack_set_ctl(card,
+				"Headphone Mono Differential Playback Switch", !hp, 0);
+	if (!ret)
+		ret = sun8i_codec_jack_set_ctl(card, "Headphone Playback Switch",
+					       1, hp);
+	if (ret == -ENOENT && ++aj->tries < 50) {
+		/* The card is still being bound: its controls are not all there */
+		schedule_delayed_work(&aj->work, msecs_to_jiffies(100));
+		return;
+	}
+	if (ret)
+		dev_err(component->dev, "Failed to switch outputs: %d\n", ret);
+
+	if (hp)
+		snd_soc_dapm_disable_pin(dapm, "Speaker");
+	else
+		snd_soc_dapm_enable_pin(dapm, "Speaker");
+	snd_soc_dapm_sync(dapm);
+}
+
+static int sun8i_codec_jack_notify(struct notifier_block *nb,
+				   unsigned long status, void *data)
+{
+	struct sun8i_codec_analog_jack *aj =
+		container_of(nb, struct sun8i_codec_analog_jack, nb);
+
+	/* Plugging can disturb the outputs: make sure the amplifier is on */
+	if (sun8i_headphone_amp_always_on(aj->component))
+		sun8i_codec_hp_on(aj->component);
+	aj->headphone = status & SND_JACK_HEADPHONE;
+	aj->tries = 0;
+	mod_delayed_work(system_percpu_wq, &aj->work, 0);
+	return NOTIFY_OK;
+}
+
+static void sun8i_codec_jack_cancel(void *data)
+{
+	struct sun8i_codec_analog_jack *aj = data;
+
+	cancel_delayed_work_sync(&aj->work);
+}
+
+static int sun8i_codec_analog_get_jack_type(struct snd_soc_component *component)
+{
+	return device_property_present(component->dev, "hp-det-gpios") ?
+	       SND_JACK_HEADPHONE : 0;
+}
+
+static int sun8i_codec_analog_set_jack(struct snd_soc_component *component,
+				       struct snd_soc_jack *jack, void *data)
+{
+	struct device *dev = component->dev;
+	struct sun8i_codec_analog_jack *aj;
+	int ret;
+
+	if (!jack)
+		return 0;
+	aj = devm_kzalloc(dev, sizeof(*aj), GFP_KERNEL);
+	if (!aj)
+		return -ENOMEM;
+	aj->component = component;
+	aj->jack = jack;
+	INIT_DELAYED_WORK(&aj->work, sun8i_codec_jack_work);
+	ret = devm_add_action_or_reset(dev, sun8i_codec_jack_cancel, aj);
+	if (ret)
+		return ret;
+
+	aj->nb.notifier_call = sun8i_codec_jack_notify;
+	snd_soc_jack_notifier_register(jack, &aj->nb);
+
+	aj->gpio.gpiod_dev = dev;
+	aj->gpio.name = "hp-det";
+	aj->gpio.report = SND_JACK_HEADPHONE;
+	aj->gpio.debounce_time = 150;
+	return snd_soc_jack_add_gpios(jack, 1, &aj->gpio);
+}
+

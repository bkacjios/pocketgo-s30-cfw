+/*
+ * Some boards sense the headphone jack through a contact that is only pulled
+ * up while the headphone amplifier is powered. There the amplifier (and
+ * HPCOM, see below) is enabled once at probe and left on, outside of DAPM:
+ * a force-enabled widget would stop power changes from propagating along the
+ * path to the outputs.
+ */
+static bool sun8i_headphone_amp_always_on(struct snd_soc_component *component)
+{
+	return device_property_read_bool(component->dev,
+					 "allwinner,headphone-amp-always-on");
+}
+
+/*
+ * Always-on boards also keep HPCOM driven: with capless headphones the plug
+ * returns through HPCOM, and an idle (undriven) HPCOM loads the amplifier's
+ * DC bias enough to reset the analog block to its power-on defaults.
+ */
+#define SUN8I_ADDA_PAEN_HP_CTRL_HP_ON	(BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN) | \
+					 (0x3 << SUN8I_ADDA_PAEN_HP_CTRL_HPCOM_FC) | \
+					 BIT(SUN8I_ADDA_PAEN_HP_CTRL_COMPTEN))
+
+#define SUN8I_ADDA_PAEN_HP_CTRL_HPCOM_ON	((0x3 << SUN8I_ADDA_PAEN_HP_CTRL_HPCOM_FC) | \
+					 BIT(SUN8I_ADDA_PAEN_HP_CTRL_COMPTEN))
+#define SUN8I_ADDA_PAEN_HP_CTRL_ANTI_POP_MAX	(0x3 << SUN8I_ADDA_PAEN_HP_CTRL_PA_ANTI_POP_CTRL)
+#define SUN8I_HP_ANTI_POP_MS	600	/* longest PA ramp, with margin */
+
+/*
+ * Switches the amplifier on without a pop: longest anti-pop ramp, HPCOM (the
+ * headphone return) settled before the PA. Nothing to do if already on.
+ */
+static void sun8i_codec_hp_on(struct snd_soc_component *component)
+{
+	unsigned int val = snd_soc_component_read(component, SUN8I_ADDA_PAEN_HP_CTRL);
+
+	if ((val & SUN8I_ADDA_PAEN_HP_CTRL_HP_ON) == SUN8I_ADDA_PAEN_HP_CTRL_HP_ON)
+		return;
+	snd_soc_component_update_bits(component, SUN8I_ADDA_PAEN_HP_CTRL,
+				      SUN8I_ADDA_PAEN_HP_CTRL_ANTI_POP_MAX |
+				      SUN8I_ADDA_PAEN_HP_CTRL_HPCOM_ON,
+				      SUN8I_ADDA_PAEN_HP_CTRL_ANTI_POP_MAX |
+				      SUN8I_ADDA_PAEN_HP_CTRL_HPCOM_ON);
+	msleep(50);
+	snd_soc_component_update_bits(component, SUN8I_ADDA_PAEN_HP_CTRL,
+				      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN),
+				      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN));
+}
+
+/*
+ * With the amplifier outside of DAPM, userspace can switch it (and HPCOM)
+ * back on should the analog block still lose its state.
+ */
+static int sun8i_codec_hp_amp_get(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	unsigned int val = snd_soc_component_read(component, SUN8I_ADDA_PAEN_HP_CTRL);
+
+	ucontrol->value.integer.value[0] =
+		(val & SUN8I_ADDA_PAEN_HP_CTRL_HP_ON) == SUN8I_ADDA_PAEN_HP_CTRL_HP_ON;
+	return 0;
+}
+
+static int sun8i_codec_hp_amp_put(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	unsigned int val = snd_soc_component_read(component, SUN8I_ADDA_PAEN_HP_CTRL);
+	bool on = (val & SUN8I_ADDA_PAEN_HP_CTRL_HP_ON) == SUN8I_ADDA_PAEN_HP_CTRL_HP_ON;
+
+	if (on == !!ucontrol->value.integer.value[0])
+		return 0;
+	if (!on)
+		sun8i_codec_hp_on(component);
+	else
+		snd_soc_component_update_bits(component, SUN8I_ADDA_PAEN_HP_CTRL,
+					      SUN8I_ADDA_PAEN_HP_CTRL_HP_ON, 0);
+	return 1;
+}
+
+static const struct snd_kcontrol_new sun8i_codec_hp_amp_switch[] = {
+	SOC_SINGLE_BOOL_EXT("Headphone Amp Playback Switch", 0,
+			    sun8i_codec_hp_amp_get, sun8i_codec_hp_amp_put),
+};

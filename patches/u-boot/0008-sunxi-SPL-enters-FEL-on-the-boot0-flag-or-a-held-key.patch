From: PocketGo S30 CFW
Subject: [PATCH] sunxi: SPL enters FEL on the boot0 flag or a held key (A33)

Allwinner's boot0 jumps to the boot ROM's FEL entry (0xffff0020) when RTC
general-purpose register 2 holds 0x5aa5a55a, clearing it first; the boot
ROM itself does not check the flag. With the SPL in the SPI flash in
boot0's place, Linux's "reboot fel" (s30-fel) needs the SPL to do the
same. SPL_FEL_KEY names a key (active low, pulled up here) that enters
FEL when held at power on, with no card and no running system needed:
the PocketGo S30 uses volume down (PG0).

diff --git a/board/sunxi/Kconfig b/board/sunxi/Kconfig
index 084a8b0c..3d77b696 100644
--- a/board/sunxi/Kconfig
+++ b/board/sunxi/Kconfig
@@ -1,3 +1,14 @@
+config SPL_FEL_KEY
+	string "GPIO of a key that enters FEL (USB boot) when held at power on"
+	depends on MACH_SUN8I_A33
+	default ""
+	help
+	  The SPL jumps to the boot ROM's FEL entry when this key (active low,
+	  pulled up by the SPL) is held at power on, so sunxi-fel can load the
+	  device over USB without a card. Empty: no key. The SPL also enters
+	  FEL once when RTC general-purpose register 2 holds the magic
+	  0x5aa5a55a, as Allwinner's boot0 does (Linux's "reboot fel").
+
 choice
 	prompt "SPL Image Type"
 	default SPL_IMAGE_TYPE_SUNXI_EGON
diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index d4d37624..31a592e0 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -11,6 +11,7 @@
  */
 
 #include <clock_legacy.h>
+#include <cpu_func.h>
 #include <dm.h>
 #include <env.h>
 #include <hang.h>
@@ -574,10 +575,49 @@ static void status_led_init(void)
 #endif
 }
 
+#ifdef CONFIG_MACH_SUN8I_A33
+/*
+ * FEL (USB boot) from the SPL, as Allwinner's boot0 does: when RTC
+ * general-purpose register 2 holds the magic (Linux's "reboot fel"), or
+ * the FEL key is held at power on, jump to the boot ROM's FEL entry. The
+ * flag is one-shot; the boot ROM only checks for it on its own when
+ * nothing boots. DRAM is not up yet, as the ROM expects.
+ */
+#define FEL_FLAG_REG	(SUNXI_RTC_BASE + 0x108)
+#define FEL_FLAG_MAGIC	0x5aa5a55a
+#define BROM_FEL_ENTRY	0xffff0020
+
+static void sunxi_fel_check(void)
+{
+	int enter = readl(FEL_FLAG_REG) == FEL_FLAG_MAGIC;
+
+	if (enter)
+		writel(0, FEL_FLAG_REG);
+	if (!enter && CONFIG_SPL_FEL_KEY[0]) {
+		int pin = sunxi_name_to_gpio(CONFIG_SPL_FEL_KEY);
+
+		if (pin >= 0) {
+			sunxi_gpio_set_cfgpin(pin, SUNXI_GPIO_INPUT);
+			sunxi_gpio_set_pull(pin, SUNXI_GPIO_PULL_UP);
+			udelay(100);
+			enter = gpio_get_value(pin) == 0;
+		}
+	}
+	if (enter) {
+		dcache_disable();
+		icache_disable();
+		((void (*)(void))BROM_FEL_ENTRY)();
+	}
+}
+#endif
+
 void sunxi_board_init(void)
 {
 	int power_failed = 0;
 
+#ifdef CONFIG_MACH_SUN8I_A33
+	sunxi_fel_check();
+#endif
 	if (CONFIG_IS_ENABLED(SUNXI_LED_STATUS))
 		status_led_init();
 

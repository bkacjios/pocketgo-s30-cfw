+// S30 (Alpine, musl): glibc functions the bionic export table refers to that
+// musl doesn't have. The locale variants use the C locale (all musl has).
+#include <errno.h>
+#include <stdint.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <locale.h>
+
+extern "C" {
+
+long strtol_l(const char* s, char** e, int b, locale_t) { return strtol(s, e, b); }
+unsigned long strtoul_l(const char* s, char** e, int b, locale_t) { return strtoul(s, e, b); }
+long long strtoll_l(const char* s, char** e, int b, locale_t) { return strtoll(s, e, b); }
+unsigned long long strtoull_l(const char* s, char** e, int b, locale_t) { return strtoull(s, e, b); }
+long wcstol_l(const wchar_t* s, wchar_t** e, int b, locale_t) { return wcstol(s, e, b); }
+unsigned long wcstoul_l(const wchar_t* s, wchar_t** e, int b, locale_t) { return wcstoul(s, e, b); }
+long long wcstoll_l(const wchar_t* s, wchar_t** e, int b, locale_t) { return wcstoll(s, e, b); }
+unsigned long long wcstoull_l(const wchar_t* s, wchar_t** e, int b, locale_t) { return wcstoull(s, e, b); }
+float wcstof_l(const wchar_t* s, wchar_t** e, locale_t) { return wcstof(s, e); }
+double wcstod_l(const wchar_t* s, wchar_t** e, locale_t) { return wcstod(s, e); }
+long double wcstold_l(const wchar_t* s, wchar_t** e, locale_t) { return wcstold(s, e); }
+
+wchar_t* wmempcpy(wchar_t* d, const wchar_t* s, size_t n) { return wmemcpy(d, s, n) + n; }
+
+int getpt(void) { return posix_openpt(O_RDWR | O_NOCTTY); }
+
+// malloc tuning and reports: not available, harmless to refuse
+int mallopt(int, int) { return 0; }
+int malloc_info(int, FILE*) { errno = ENOSYS; return -1; }
+
+int __register_atfork(void (*prepare)(void), void (*parent)(void), void (*child)(void), void*) {
+	return pthread_atfork(prepare, parent, child);
+}
+
+// thread_local destructors: run at thread exit, last registered first
+struct ThreadDtor {
+	void (*fn)(void*);
+	void* obj;
+	ThreadDtor* next;
+};
+static pthread_key_t sDtorKey;
+static pthread_once_t sDtorOnce = PTHREAD_ONCE_INIT;
+
+static void run_dtors(void* p) {
+	for (ThreadDtor* d = (ThreadDtor*)p; d != nullptr;) {
+		ThreadDtor* next = d->next;
+		d->fn(d->obj);
+		free(d);
+		d = next;
+	}
+}
+
+static void make_key(void) { pthread_key_create(&sDtorKey, run_dtors); }
+
+int __cxa_thread_atexit_impl(void (*fn)(void*), void* obj, void*) {
+	ThreadDtor* d = (ThreadDtor*)malloc(sizeof(*d));
+
+	if (d == nullptr) {
+		return -1;
+	}
+	pthread_once(&sDtorOnce, make_key);
+	d->fn = fn;
+	d->obj = obj;
+	d->next = (ThreadDtor*)pthread_getspecific(sDtorKey);
+	pthread_setspecific(sDtorKey, d);
+	return 0;
+}
+
+
+
+}

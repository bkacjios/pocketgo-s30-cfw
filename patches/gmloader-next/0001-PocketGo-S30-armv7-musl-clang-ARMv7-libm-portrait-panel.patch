+/* ---- signals: bionic LP32 sigset_t is 32 bits (signals 1-32) ---- */
+
+struct b_sigaction {
+    void* handler; // sa_handler / sa_sigaction
+    uint32_t sa_mask;
+    uint32_t sa_flags;
+    void* sa_restorer;
+};
+
+static void set_in(sigset_t* h, uint32_t b) {
+    sigemptyset(h);
+    for (int i = 1; i <= 32; i++) {
+        if (b & (1u << (i - 1))) {
+            sigaddset(h, i);
+        }
+    }
+}
+
+static uint32_t set_out(const sigset_t* h) {
+    uint32_t b = 0;
+
+    for (int i = 1; i <= 32; i++) {
+        if (sigismember(h, i) == 1) {
+            b |= 1u << (i - 1);
+        }
+    }
+    return b;
+}
+
+ABI_ATTR int sigemptyset_impl(uint32_t* s) { *s = 0; return 0; }
+ABI_ATTR int sigfillset_impl(uint32_t* s) { *s = ~0u; return 0; }
+
+ABI_ATTR int sigaddset_impl(uint32_t* s, int n) {
+    if (n < 1 || n > 32) {
+        errno = EINVAL;
+        return -1;
+    }
+    *s |= 1u << (n - 1);
+    return 0;
+}
+
+ABI_ATTR int sigdelset_impl(uint32_t* s, int n) {
+    if (n < 1 || n > 32) {
+        errno = EINVAL;
+        return -1;
+    }
+    *s &= ~(1u << (n - 1));
+    return 0;
+}
+
+ABI_ATTR int sigismember_impl(const uint32_t* s, int n) {
+    if (n < 1 || n > 32) {
+        errno = EINVAL;
+        return -1;
+    }
+    return (*s >> (n - 1)) & 1;
+}
+
+ABI_ATTR int sigprocmask_impl(int how, const uint32_t* set, uint32_t* old) {
+    sigset_t h, o;
+    int r;
+
+    if (set != NULL) {
+        set_in(&h, *set);
+    }
+    r = sigprocmask(how, set != NULL ? &h : NULL, &o);
+    if (r == 0 && old != NULL) {
+        *old = set_out(&o);
+    }
+    return r;
+}
+
+ABI_ATTR int pthread_sigmask_impl(int how, const uint32_t* set, uint32_t* old) {
+    sigset_t h, o;
+    int r;
+
+    if (set != NULL) {
+        set_in(&h, *set);
+    }
+    r = pthread_sigmask(how, set != NULL ? &h : NULL, &o);
+    if (r == 0 && old != NULL) {
+        *old = set_out(&o);
+    }
+    return r;
+}
+
+ABI_ATTR int sigsuspend_impl(const uint32_t* set) {
+    sigset_t h;
+
+    set_in(&h, *set);
+    return sigsuspend(&h);
+}
+
+ABI_ATTR int sigpending_impl(uint32_t* set) {
+    sigset_t h;
+    int r = sigpending(&h);
+
+    if (r == 0) {
+        *set = set_out(&h);
+    }
+    return r;
+}
+
+ABI_ATTR int sigwait_impl(const uint32_t* set, int* sig) {
+    sigset_t h;
+
+    set_in(&h, *set);
+    return sigwait(&h, sig);
+}
+
+ABI_ATTR int sigaction_impl(int sig, const struct b_sigaction* act, struct b_sigaction* old) {
+    struct sigaction h, o;
+    int r;
+
+    // Debugging (S30_GML_KEEP_SEGV=1): keep the loader's crash report for faults
+    if (act != NULL && (sig == SIGSEGV || sig == SIGBUS || sig == SIGILL) && getenv("S30_GML_KEEP_SEGV")) {
+        if (old != NULL) {
+            memset(old, 0, sizeof(*old));
+        }
+        return 0;
+    }
+    if (act != NULL) {
+        memset(&h, 0, sizeof(h));
+        h.sa_sigaction = (void (*)(int, siginfo_t*, void*))act->handler;
+        set_in(&h.sa_mask, act->sa_mask);
+        h.sa_flags = (int)(act->sa_flags & ~0x04000000u); // SA_RESTORER: musl's own
+    }
+    r = sigaction(sig, act != NULL ? &h : NULL, &o);
+    if (r == 0 && old != NULL) {
+        old->handler = (void*)o.sa_sigaction;
+        old->sa_mask = set_out(&o.sa_mask);
+        old->sa_flags = (uint32_t)o.sa_flags;
+        old->sa_restorer = NULL;
+    }
+    return r;
+}
+
+/* ---- sigsetjmp: musl's sigjmp_buf (~388 bytes) is bigger than bionic's
+   (256): the mask goes to a side table, the registers to musl's setjmp
+   (which writes ~104 bytes). The stub tail-calls setjmp so it saves the
+   guest's own sp and lr. ---- */
+
+#define S30_JMP_SLOTS 64
+static struct {
+    void* env;
+    uint32_t saved; // savemask was set
+    sigset_t mask;
+} sJmpSlots[S30_JMP_SLOTS];
+static unsigned sJmpNext;
+
+extern "C" void s30_sigsetjmp_save(void* env, int savemask) {
+    unsigned i, slot = S30_JMP_SLOTS;
+
+    for (i = 0; i < S30_JMP_SLOTS; i++) {
+        if (sJmpSlots[i].env == env) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot == S30_JMP_SLOTS) {
+        slot = sJmpNext++ % S30_JMP_SLOTS;
+        sJmpSlots[slot].env = env;
+    }
+    sJmpSlots[slot].saved = savemask != 0;
+    if (savemask) {
+        pthread_sigmask(SIG_BLOCK, NULL, &sJmpSlots[slot].mask);
+    }
+}
+
+__attribute__((naked)) int sigsetjmp_impl(void* env, int savemask) {
+    asm volatile(
+        "push {r0, r1, r2, lr}\n"
+        "bl s30_sigsetjmp_save\n"
+        "pop {r0, r1, r2, lr}\n"
+        "b setjmp\n");
+}
+
+ABI_ATTR void siglongjmp_impl(void* env, int val) {
+    for (unsigned i = 0; i < S30_JMP_SLOTS; i++) {
+        if (sJmpSlots[i].env == env) {
+            if (sJmpSlots[i].saved) {
+                pthread_sigmask(SIG_SETMASK, &sJmpSlots[i].mask, NULL);
+            }
+            break;
+        }
+    }
+    longjmp(*(jmp_buf*)env, val);
+}
+
+/* ---- debugging: who raises a signal (the runner's own crash path) ---- */
+
+extern "C" void s30_report_address(const char* what, uintptr_t addr);
+
+ABI_ATTR int raise_impl(int sig) {
+    fprintf(stderr, "\n*** guest raise(%d)\n", sig);
+    s30_report_address("called from", (uintptr_t)__builtin_return_address(0));
+    return raise(sig);
+}
+
+/* ---- bionic-only ---- */
+
+ABI_ATTR void __assert2_impl(const char* file, int line, const char* func, const char* expr) {
+    fprintf(stderr, "%s:%d: %s: assertion \"%s\" failed\n", file, line, func, expr);
+    abort();
+}
+
+/* musl has no mallinfo (struct b_mallinfo: bionic32_types.h) */
+ABI_ATTR struct b_mallinfo mallinfo_impl(void) {
+    struct b_mallinfo m;
+
+    memset(&m, 0, sizeof(m));
+    return m;
+}
+
+ABI_ATTR int flock_impl(int fd, int op) {
+    return flock(fd, op);
+}
+
+}

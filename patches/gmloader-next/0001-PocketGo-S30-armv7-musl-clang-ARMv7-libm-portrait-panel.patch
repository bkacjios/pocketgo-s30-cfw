diff --git a/thunks/libc/bionic32.cpp b/thunks/libc/bionic32.cpp
new file mode 100644
index 0000000..63792c9
--- /dev/null
+++ b/thunks/libc/bionic32.cpp
@@ -0,0 +1,666 @@
+// S30 (Alpine, musl): Android armv7's 32-bit time_t, off_t and rlim_t
+// against musl armv7's 64-bit ones. A direct thunk would hand the guest's
+// structs and arguments to musl in the wrong layout, so these convert. Also
+// the bionic-only and variadic functions the GameMaker runner imports.
+#include "musl_compat.h"
+#include <errno.h>
+#include <semaphore.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <sys/select.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "platform.h"
+#include "bionic32_types.h"
+#include "bionic_file.h"
+
+/* The guest's FILE* is a bridge around musl's (thunks/libc/stdio.cpp) */
+static FILE* host_file(FILE* g) {
+    return g != NULL ? (FILE*)((BIONIC_FILE*)g)->_cookie : NULL;
+}
+
+struct b_timespec {
+    int32_t tv_sec;
+    int32_t tv_nsec;
+};
+
+struct b_timeval {
+    int32_t tv_sec;
+    int32_t tv_usec;
+};
+
+struct b_rlimit {
+    uint32_t rlim_cur;
+    uint32_t rlim_max;
+};
+
+// bionic arm struct stat (__STAT64_BODY)
+struct b_stat {
+    unsigned long long st_dev;
+    unsigned char __pad0[4];
+    uint32_t __st_ino;
+    uint32_t st_mode;
+    uint32_t st_nlink;
+    uint32_t st_uid;
+    uint32_t st_gid;
+    unsigned long long st_rdev;
+    unsigned char __pad3[4];
+    long long st_size;
+    uint32_t st_blksize;
+    unsigned long long st_blocks;
+    struct b_timespec st_atim;
+    struct b_timespec st_mtim;
+    struct b_timespec st_ctim;
+    unsigned long long st_ino;
+};
+static_assert(sizeof(struct b_stat) == 104, "bionic arm struct stat is 104 bytes");
+
+static struct timespec ts_in(const struct b_timespec* b) {
+    struct timespec t = { b->tv_sec, b->tv_nsec };
+    return t;
+}
+
+static void ts_out(struct b_timespec* b, const struct timespec* t) {
+    b->tv_sec = (int32_t)t->tv_sec;
+    b->tv_nsec = (int32_t)t->tv_nsec;
+}
+
+static void stat_out(struct b_stat* b, const struct stat* s) {
+    memset(b, 0, sizeof(*b));
+    b->st_dev = s->st_dev;
+    b->__st_ino = (uint32_t)s->st_ino;
+    b->st_mode = s->st_mode;
+    b->st_nlink = s->st_nlink;
+    b->st_uid = s->st_uid;
+    b->st_gid = s->st_gid;
+    b->st_rdev = s->st_rdev;
+    b->st_size = s->st_size;
+    b->st_blksize = s->st_blksize;
+    b->st_blocks = s->st_blocks;
+    ts_out(&b->st_atim, &s->st_atim);
+    ts_out(&b->st_mtim, &s->st_mtim);
+    ts_out(&b->st_ctim, &s->st_ctim);
+    b->st_ino = s->st_ino;
+}
+
+extern "C" {
+
+/* ---- time ---- */
+
+ABI_ATTR b_time_t time_impl(b_time_t* out) {
+    b_time_t t = (b_time_t)time(NULL);
+
+    if (out != NULL) {
+        *out = t;
+    }
+    return t;
+}
+
+ABI_ATTR int clock_gettime_impl(clockid_t clk, struct b_timespec* out) {
+    struct timespec t;
+    int r = clock_gettime(clk, &t);
+
+    if (r == 0 && out != NULL) {
+        ts_out(out, &t);
+    }
+    return r;
+}
+
+ABI_ATTR int clock_getres_impl(clockid_t clk, struct b_timespec* out) {
+    struct timespec t;
+    int r = clock_getres(clk, &t);
+
+    if (r == 0 && out != NULL) {
+        ts_out(out, &t);
+    }
+    return r;
+}
+
+ABI_ATTR int nanosleep_impl(const struct b_timespec* req, struct b_timespec* rem) {
+    struct timespec r = ts_in(req), left;
+    int ret = nanosleep(&r, &left);
+
+    if (ret != 0 && rem != NULL) {
+        ts_out(rem, &left);
+    }
+    return ret;
+}
+
+ABI_ATTR int clock_nanosleep_impl(clockid_t clk, int flags, const struct b_timespec* req, struct b_timespec* rem) {
+    struct timespec r = ts_in(req), left;
+    int ret = clock_nanosleep(clk, flags, &r, &left);
+
+    if (ret == EINTR && rem != NULL) {
+        ts_out(rem, &left);
+    }
+    return ret;
+}
+
+ABI_ATTR int gettimeofday_impl(struct b_timeval* out, void* tz) {
+    struct timeval t;
+    int r = gettimeofday(&t, NULL);
+
+    (void)tz;
+    if (r == 0 && out != NULL) {
+        out->tv_sec = (int32_t)t.tv_sec;
+        out->tv_usec = (int32_t)t.tv_usec;
+    }
+    return r;
+}
+
+ABI_ATTR int select_impl(int n, fd_set* rd, fd_set* wr, fd_set* ex, struct b_timeval* tv) {
+    struct timeval t, *tp = NULL;
+    int r;
+
+    if (tv != NULL) {
+        t.tv_sec = tv->tv_sec;
+        t.tv_usec = tv->tv_usec;
+        tp = &t;
+    }
+    r = select(n, rd, wr, ex, tp);
+    if (tv != NULL) {
+        tv->tv_sec = (int32_t)t.tv_sec;
+        tv->tv_usec = (int32_t)t.tv_usec;
+    }
+    return r;
+}
+
+ABI_ATTR int ppoll_impl(struct pollfd* fds, nfds_t n, const struct b_timespec* ts, const sigset_t* mask) {
+    struct timespec t;
+
+    if (ts != NULL) {
+        t = ts_in(ts);
+    }
+    return ppoll(fds, n, ts != NULL ? &t : NULL, mask);
+}
+
+ABI_ATTR struct tm* localtime_impl(const b_time_t* t) {
+    time_t h = *t;

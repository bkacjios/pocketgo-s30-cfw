new file mode 100644
index 0000000..c9253a4
--- /dev/null
+++ b/s30/musl_compat.h
@@ -0,0 +1,72 @@
+/* S30 (Alpine, musl): the glibc extensions gmloader-next uses */
+#pragma once
+#ifndef IS_TAB_GEN /* not in the bare prototype list (thunks/libc/c_prototypes.h) */
+#ifndef _LARGEFILE64_SOURCE
+#define _LARGEFILE64_SOURCE 1 /* fopen64, pread64, off64_t ... */
+#endif
+#include <dirent.h>
+#include <fcntl.h>
+#include <libgen.h> /* basename (glibc: string.h) */
+#include <stdlib.h>
+#include <string.h>
+#include <sys/select.h>
+#include <unistd.h>
+
+typedef int (*__compar_fn_t)(const void*, const void*);
+#ifndef __FD_ISSET
+#define __FD_ISSET(fd, set) FD_ISSET(fd, set)
+#define __FD_SET(fd, set) FD_SET(fd, set)
+#define __FD_CLR(fd, set) FD_CLR(fd, set)
+#endif
+
+/* scandirat: scandir relative to a directory fd (not in musl) */
+static inline int scandirat(int dirfd, const char* path, struct dirent*** list,
+                            int (*sel)(const struct dirent*),
+                            int (*cmp)(const struct dirent**, const struct dirent**)) {
+	int fd = openat(dirfd, path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	DIR* d;
+	struct dirent *e, **v = NULL;
+	size_t n = 0, cap = 0;
+
+	if (fd < 0) {
+		return -1;
+	}
+	d = fdopendir(fd);
+	if (d == NULL) {
+		close(fd);
+		return -1;
+	}
+	while ((e = readdir(d)) != NULL) {
+		if (sel != NULL && !sel(e)) {
+			continue;
+		}
+		if (n == cap) {
+			struct dirent** t;
+			cap = cap ? cap * 2 : 16;
+			t = (struct dirent**)realloc(v, cap * sizeof(*v));
+			if (t == NULL) {
+				goto fail;
+			}
+			v = t;
+		}
+		v[n] = (struct dirent*)malloc(sizeof(*e));
+		if (v[n] == NULL) {
+			goto fail;
+		}
+		memcpy(v[n++], e, sizeof(*e));
+	}
+	closedir(d);
+	if (cmp != NULL) {
+		qsort(v, n, sizeof(*v), (__compar_fn_t)cmp);
+	}
+	*list = v;
+	return (int)n;
+fail:
+	while (n > 0) {
+		free(v[--n]);
+	}
+	free(v);
+	closedir(d);
+	return -1;
+}
+#endif

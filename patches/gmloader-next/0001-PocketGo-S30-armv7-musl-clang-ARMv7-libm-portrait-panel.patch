diff --git a/gmloader/s30_rotate.cpp b/gmloader/s30_rotate.cpp
new file mode 100644
index 0000000..d48ecc5
--- /dev/null
+++ b/gmloader/s30_rotate.cpp
@@ -0,0 +1,199 @@
+// S30: the PocketGo S30's panel is portrait (320x480) and mounted sideways.
+// When the window is taller than wide, the game gets a landscape size and
+// draws into an offscreen framebuffer of that size (its "default framebuffer"
+// 0 maps there), which is drawn rotated onto the panel before each swap.
+// Landscape (x, y) is panel (y, 479 - x), as everywhere on the S30.
+#include <SDL2/SDL.h>
+#include <string.h>
+#include "../thunks/khronos/glad.h"
+
+#include "platform.h"
+#include "so_util.h"
+#include "thunk_gen.h"
+
+extern DynLibFunction symtable_gles2[];
+
+static int sOn;
+static int sW, sH; // landscape size the game draws at
+static int sPanelW, sPanelH;
+static GLuint sFbo, sTex, sDepth, sProg, sVbo;
+static GLint sPosLoc, sUvLoc;
+static GLuint sGameFb; // bound when the frame ended
+
+ABI_ATTR static void bind_framebuffer_impl(GLenum target, GLuint fb) {
+    glad_glBindFramebuffer(target, fb == 0 ? sFbo : fb);
+}
+
+ABI_ATTR static void get_integerv_impl(GLenum pname, GLint* v) {
+    glad_glGetIntegerv(pname, v);
+    if (pname == GL_FRAMEBUFFER_BINDING && *v == (GLint)sFbo) {
+        *v = 0;
+    }
+}
+
+static void replace(const char* name, uintptr_t func) {
+    for (int i = 0; symtable_gles2[i].symbol != NULL; i++) {
+        if (strcmp(symtable_gles2[i].symbol, name) == 0) {
+            symtable_gles2[i].func = func;
+            return;
+        }
+    }
+}
+
+static GLuint shader(GLenum type, const char* src) {
+    GLuint s = glad_glCreateShader(type);
+
+    glad_glShaderSource(s, 1, &src, NULL);
+    glad_glCompileShader(s);
+    return s;
+}
+
+// Call after load_gles2_funcs(). *w, *h: the size to give the game.
+void s30_rotate_init(SDL_Window* win, int* w, int* h) {
+    // panel corner, uv: landscape x along the panel's height, y across it
+    static const float quad[] = {
+        -1.0f, -1.0f, 0.0f, 1.0f,
+         1.0f, -1.0f, 0.0f, 0.0f,
+        -1.0f,  1.0f, 1.0f, 1.0f,
+         1.0f,  1.0f, 1.0f, 0.0f,
+    };
+    GLuint vs, fs;
+
+    SDL_GL_GetDrawableSize(win, &sPanelW, &sPanelH);
+    *w = sPanelW;
+    *h = sPanelH;
+    if (sPanelH <= sPanelW) {
+        return;
+    }
+    sOn = 1;
+    sW = sPanelH;
+    sH = sPanelW;
+    *w = sW;
+    *h = sH;
+
+    glad_glGenTextures(1, &sTex);
+    glad_glBindTexture(GL_TEXTURE_2D, sTex);
+    glad_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, sW, sH, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glad_glGenRenderbuffers(1, &sDepth);
+    glad_glBindRenderbuffer(GL_RENDERBUFFER, sDepth);
+    glad_glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8_OES, sW, sH);
+    glad_glGenFramebuffers(1, &sFbo);
+    glad_glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+    glad_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sTex, 0);
+    glad_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, sDepth);
+    glad_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, sDepth);
+    if (glad_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        fprintf(stderr, "s30_rotate: offscreen framebuffer incomplete, not rotating\n");
+        glad_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        sOn = 0;
+        *w = sPanelW;
+        *h = sPanelH;
+        return;
+    }
+
+    vs = shader(GL_VERTEX_SHADER,
+                "attribute vec2 aPos; attribute vec2 aUv; varying vec2 vUv;\n"
+                "void main() { vUv = aUv; gl_Position = vec4(aPos, 0.0, 1.0); }\n");
+    fs = shader(GL_FRAGMENT_SHADER,
+                "precision mediump float; varying vec2 vUv; uniform sampler2D uTex;\n"
+                "void main() { gl_FragColor = texture2D(uTex, vUv); }\n");
+    sProg = glad_glCreateProgram();
+    glad_glAttachShader(sProg, vs);
+    glad_glAttachShader(sProg, fs);
+    glad_glLinkProgram(sProg);
+    sPosLoc = glad_glGetAttribLocation(sProg, "aPos");
+    sUvLoc = glad_glGetAttribLocation(sProg, "aUv");
+    glad_glGenBuffers(1, &sVbo);
+    glad_glBindBuffer(GL_ARRAY_BUFFER, sVbo);
+    glad_glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glad_glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+    replace("glBindFramebuffer", (uintptr_t)&bind_framebuffer_impl);
+    replace("glGetIntegerv", (uintptr_t)&get_integerv_impl);
+    glad_glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+    glad_glViewport(0, 0, sW, sH);
+    fprintf(stderr, "s30_rotate: %dx%d panel, the game at %dx%d\n", sPanelW, sPanelH, sW, sH);
+}
+
+// Before SDL_GL_SwapWindow: the offscreen frame onto the panel, rotated.
+// The game's GL state is put back afterwards.
+void s30_rotate_present(void) {
+    GLint fb, prog, tex, unit, abuf, vp[4], en[2], size[2], type[2], norm[2], stride[2];
+    GLvoid* ptr[2];
+    GLboolean blend, depth, scissor, cull, stencil, mask[4];
+    GLint locs[2] = { sPosLoc, sUvLoc };
+
+    if (!sOn) {
+        return;
+    }
+    glad_glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fb);
+    glad_glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+    glad_glGetIntegerv(GL_ACTIVE_TEXTURE, &unit);
+    glad_glActiveTexture(GL_TEXTURE0);
+    glad_glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex);
+    glad_glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &abuf);
+    glad_glGetIntegerv(GL_VIEWPORT, vp);
+    glad_glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    blend = glad_glIsEnabled(GL_BLEND);
+    depth = glad_glIsEnabled(GL_DEPTH_TEST);
+    scissor = glad_glIsEnabled(GL_SCISSOR_TEST);
+    cull = glad_glIsEnabled(GL_CULL_FACE);
+    stencil = glad_glIsEnabled(GL_STENCIL_TEST);
+    for (int i = 0; i < 2; i++) {
+        glad_glGetVertexAttribiv(locs[i], GL_VERTEX_ATTRIB_ARRAY_ENABLED, &en[i]);
+        glad_glGetVertexAttribiv(locs[i], GL_VERTEX_ATTRIB_ARRAY_SIZE, &size[i]);
+        glad_glGetVertexAttribiv(locs[i], GL_VERTEX_ATTRIB_ARRAY_TYPE, &type[i]);
+        glad_glGetVertexAttribiv(locs[i], GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &norm[i]);
+        glad_glGetVertexAttribiv(locs[i], GL_VERTEX_ATTRIB_ARRAY_STRIDE, &stride[i]);
+        glad_glGetVertexAttribPointerv(locs[i], GL_VERTEX_ATTRIB_ARRAY_POINTER, &ptr[i]);
+    }
+
+    glad_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glad_glViewport(0, 0, sPanelW, sPanelH);
+    glad_glDisable(GL_BLEND);
+    glad_glDisable(GL_DEPTH_TEST);
+    glad_glDisable(GL_SCISSOR_TEST);
+    glad_glDisable(GL_CULL_FACE);
+    glad_glDisable(GL_STENCIL_TEST);
+    glad_glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glad_glUseProgram(sProg);
+    glad_glBindTexture(GL_TEXTURE_2D, sTex);
+    glad_glBindBuffer(GL_ARRAY_BUFFER, sVbo);
+    glad_glEnableVertexAttribArray(sPosLoc);
+    glad_glEnableVertexAttribArray(sUvLoc);
+    glad_glVertexAttribPointer(sPosLoc, 2, GL_FLOAT, GL_FALSE, 16, (const void*)0);
+    glad_glVertexAttribPointer(sUvLoc, 2, GL_FLOAT, GL_FALSE, 16, (const void*)8);
+    glad_glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+    // The game's state back (the framebuffer after the swap: s30_rotate_after_swap)
+    glad_glBindBuffer(GL_ARRAY_BUFFER, abuf);
+    for (int i = 0; i < 2; i++) {
+        glad_glVertexAttribPointer(locs[i], size[i], type[i], norm[i], stride[i], ptr[i]);
+        if (!en[i]) {
+            glad_glDisableVertexAttribArray(locs[i]);
+        }
+    }
+    glad_glBindBuffer(GL_ARRAY_BUFFER, abuf);
+    glad_glBindTexture(GL_TEXTURE_2D, tex);
+    glad_glActiveTexture(unit);
+    glad_glUseProgram(prog);
+    glad_glColorMask(mask[0], mask[1], mask[2], mask[3]);
+    (blend ? glad_glEnable : glad_glDisable)(GL_BLEND);
+    (depth ? glad_glEnable : glad_glDisable)(GL_DEPTH_TEST);
+    (scissor ? glad_glEnable : glad_glDisable)(GL_SCISSOR_TEST);
+    (cull ? glad_glEnable : glad_glDisable)(GL_CULL_FACE);
+    (stencil ? glad_glEnable : glad_glDisable)(GL_STENCIL_TEST);
+    glad_glViewport(vp[0], vp[1], vp[2], vp[3]);
+    sGameFb = (GLuint)fb;
+}
+
+// After SDL_GL_SwapWindow: the game's framebuffer again
+void s30_rotate_after_swap(void) {
+    if (sOn) {
+        glad_glBindFramebuffer(GL_FRAMEBUFFER, sGameFb);
+    }
+}

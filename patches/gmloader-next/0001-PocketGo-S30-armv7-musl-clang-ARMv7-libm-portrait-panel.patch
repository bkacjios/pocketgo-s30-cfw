+++ b/loader/so_util.cpp
@@ -47,6 +47,75 @@
 #define PATCH_SZ 0x10000 //64 KB-ish arenas
 static so_module *head = NULL;
 
+// S30: on a crash, where (guest module + offset, or host library)
+#include <signal.h>
+#include <ucontext.h>
+#include <dlfcn.h>
+static void s30_where(const char* what, uintptr_t addr) {
+  so_module *best = NULL;
+  Dl_info info;
+
+  for (so_module *m = head; m != NULL; m = m->next) {
+    if (m->base <= addr && (best == NULL || m->base > best->base))
+      best = m;
+  }
+  if (best != NULL && addr - best->base < 0x4000000) {
+    fprintf(stderr, "  %s %08x = %s+0x%x\n", what, (unsigned)addr, best->soname ? best->soname : "?",
+            (unsigned)(addr - best->base));
+  } else if (dladdr((void*)addr, &info) && info.dli_fname) {
+    fprintf(stderr, "  %s %08x = host %s+0x%x (%s)\n", what, (unsigned)addr, info.dli_fname,
+            (unsigned)(addr - (uintptr_t)info.dli_fbase), info.dli_sname ? info.dli_sname : "?");
+  } else {
+    fprintf(stderr, "  %s %08x\n", what, (unsigned)addr);
+  }
